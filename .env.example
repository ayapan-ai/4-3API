OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Googleスプレッドシート連携用
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SHEET_NAME=シート1
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id
GOOGLE_OAUTH_CLIENT_FILE=client_secret.json

# YouTube Data API v3
YOUTUBE_API_KEY=your-youtube-api-key

# Slack API
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_CHANNEL=#general

# Discord Webhook（通知先チャンネルごとに1本）
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxxxxxx/xxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_USERNAME=通知Bot
DISCORD_AVATAR_URL=

# Discord 自動返信Bot（discord_autoreply.py）
# ※ Developer Portal の Bot タブで「MESSAGE CONTENT INTENT」を ON にすること
DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx.xxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_TRIGGER_WORD=資料
DISCORD_REPLY_TEXT=ありがとうございます

# LINE Messaging API（line_push.py / line_webhook.py / line_reminder.py）
# 長期のチャネルアクセストークン（Messaging API設定タブで発行）
LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# チャネルシークレット（Webhookの署名検証に使用。基本設定タブで発行）
LINE_CHANNEL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 送信先 userId（チャネル基本設定タブの Your user ID など。line_push.py / line_reminder.py の送信先）
LINE_TO=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LINE Webhookでのリマインド設定（line_reminder.py。cron等で定期実行する）
# 予定開始の何分前までを通知対象にするか
REMINDER_MINUTES_BEFORE=30

# 候補日提案の営業時間（line_webhook.py / calendar_freebusy.py）
CANDIDATE_BUSINESS_START=10:00
CANDIDATE_BUSINESS_END=18:00
